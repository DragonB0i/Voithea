*.iml
.gradle
/local.properties
/.idea/caches
/.idea/libraries
/.idea/modules.xml
/.idea/workspace.xml
/.idea/navEditor.xml
/.idea/assetWizardSettings.xml
.DS_Store
/build
/captures
.externalNativeBuild
.cxx
local.properties
cat > .gitignore <<'EOF'
# Gradle
.gradle/
build/
**/build/

# Android Studio
.idea/
*.iml
captures/
.externalNativeBuild/
.cxx/

# Local SDK configuration
local.properties

# Signing keys
*.jks
*.keystore

# Secrets and environment files
.env
.env.*
!.env.example
secrets.properties
secret.properties

# Logs
*.log

# OS files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.bak
EOF